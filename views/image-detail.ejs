<%- include('partials-header', { title, isCreator }) %>
<% if (message) { %><div class="notice"><%= message %></div><% } %>
<% if (error) { %><div class="error"><%= error %></div><% } %>

<section class="detail-layout">
  <div class="image-stage">
    <img src="<%= image.imageUrl %>" alt="<%= image.title %>">
  </div>
  <aside class="detail-panel">
    <p class="eyebrow">Image detail</p>
    <h1><%= image.title %></h1>
    <p><%= image.caption %></p>
    <dl class="info-list">
      <div><dt>Location</dt><dd><%= image.location || 'Not specified' %></dd></div>
      <div><dt>People</dt><dd><%= image.people || 'Not specified' %></dd></div>
      <div><dt>Creator</dt><dd><%= image.creatorName %></dd></div>
      <div><dt>Uploaded</dt><dd><%= new Date(image.createdAt).toLocaleString() %></dd></div>
      <div><dt>Rating</dt><dd><%= stats.count ? `${stats.average}/5 from ${stats.count} rating(s)` : 'No ratings yet' %></dd></div>
    </dl>
  </aside>
</section>

<section class="interaction-grid">
  <form class="form-card" method="post" action="/image/<%= image.id %>/comment">
    <h2>Add comment</h2>
    <label>Your name
      <input type="text" name="name" placeholder="Anonymous allowed">
    </label>
    <label>Comment
      <textarea name="comment" rows="4" required placeholder="Write your comment"></textarea>
    </label>
    <button class="primary-button" type="submit">Post comment</button>
  </form>

  <form class="form-card" method="post" action="/image/<%= image.id %>/rate">
    <h2>Rate image</h2>
    <label>Your name
      <input type="text" name="name" placeholder="Anonymous allowed">
    </label>
    <label>Rating
      <select name="rating" required>
        <option value="5">5 - Excellent</option>
        <option value="4">4 - Very good</option>
        <option value="3">3 - Good</option>
        <option value="2">2 - Fair</option>
        <option value="1">1 - Poor</option>
      </select>
    </label>
    <button class="primary-button" type="submit">Submit rating</button>
  </form>
</section>

<section class="panel comments-panel">
  <h2>Consumer comments</h2>
  <% if (comments.length === 0) { %>
    <p class="muted">No comments yet.</p>
  <% } else { %>
    <div class="comment-list">
      <% comments.forEach((comment) => { %>
        <article class="comment">
          <strong><%= comment.name %></strong>
          <small><%= new Date(comment.createdAt).toLocaleString() %></small>
          <p><%= comment.comment %></p>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials-footer') %>
